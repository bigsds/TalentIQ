# ═══════════════════════════════════════════════════════════════
# SoftTalent — Variables d'environnement
# Copier ce fichier en .env et remplir toutes les valeurs
# ═══════════════════════════════════════════════════════════════

# ─── Base de données ────────────────────────────────────────────
POSTGRES_DB=hg_recrutement
POSTGRES_USER=hg_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Pour le container SoftTalent (interne Docker)
DATABASE_URL=postgresql://hg_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/hg_recrutement

# ─── Authentification ───────────────────────────────────────────
# Générer avec: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
NEXTAUTH_URL=https://app.votredomaine.com

# Compte admin de secours (optionnel si vous utilisez le seed)
ADMIN_EMAIL=admin@votrecabinet.com
ADMIN_PASSWORD_HASH=

# ─── N8n ────────────────────────────────────────────────────────
N8N_DOMAIN=n8n.votredomaine.com
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_N8N_PASSWORD
# Générer avec: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_HEX

# URL interne Docker (utilisée par SoftTalent)
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_NOUVEAU_MANDAT=/webhook/hg-nouveau-mandat
N8N_WEBHOOK_RECHERCHE=/webhook/hg-recherche

# ─── Application ────────────────────────────────────────────────
APP_DOMAIN=app.votredomaine.com
NEXT_PUBLIC_APP_NAME=SoftTalent
NEXT_PUBLIC_CABINET_NOM=Nom de votre cabinet
NEXT_PUBLIC_PRIMARY_COLOR=#1F4E79

# ─── Seed (premier déploiement uniquement) ──────────────────────
ADMIN_SEED_PASSWORD=CHANGE_ME_FIRST_LOGIN_PASSWORD
ADMIN_NOM=Administrateur
